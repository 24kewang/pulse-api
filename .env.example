# Local development settings: copy to `.env` (gitignored) and fill in.
# Values come from the pulse-DEV Supabase project. Ask the API owner for them. Never put pulse-prod keys here.
# Running tests (`npm test`) does not need any of these.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public Storage bucket for past-event images. Confirm with Kevin before deployment.
PAST_EVENT_PHOTOS_BUCKET=past-event-photos

# Optional: a pulse-dev test user, used by `npm run token` to get an access token for protected endpoints.
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

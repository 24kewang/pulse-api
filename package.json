{
    "name": "pulse-api",
    "version": "0.1.0",
    "private": true,
    "description": "Backend API for the Pulse club website",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "token": "tsx --env-file=.env scripts/get-token.ts",
        "build": "tsc --noEmit",
        "lint": "eslint src api scripts --fix",
        "lint:check": "eslint src api scripts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify": "npm run build && npm run lint:check && npm run format:check"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@supabase/supabase-js": "^2.117.2",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.4",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.39.5",
        "prettier": "^3.9.9",
        "supertest": "^7.3.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^3.2.7"
    }
}
